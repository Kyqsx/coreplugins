<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>br.com.coreplugins</groupId><artifactId>coreplugins</artifactId><version>1.0.0</version>
  </parent>

  <artifactId>produto-corespawners</artifactId>
  <name>coreSpawners</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Hora da compilação gravada em build.properties (aparece em /spawners debug). Sempre em UTC. -->
    <maven.build.timestamp.format>yyyy-MM-dd HH:mm 'UTC'</maven.build.timestamp.format>
  </properties>

  <repositories>
    <repository><id>jitpack.io</id><url>https://jitpack.io</url></repository>
    <repository><id>placeholderapi</id><url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url></repository>
  </repositories>

  <dependencies>
    <dependency><groupId>org.spigotmc</groupId><artifactId>spigot-api</artifactId></dependency>
    <!-- provided: o loader já traz a API. NUNCA faça shade dela. -->
    <dependency><groupId>br.com.coreplugins</groupId><artifactId>coreplugins-api</artifactId><scope>provided</scope></dependency>
    <!-- Vault: só compilação (softdepend), nunca embutido. Só é tocado pela classe VaultProvider. -->
    <dependency>
      <groupId>com.github.MilkBowl</groupId><artifactId>VaultAPI</artifactId><version>1.7</version><scope>provided</scope>
      <exclusions><exclusion><groupId>org.bukkit</groupId><artifactId>bukkit</artifactId></exclusion></exclusions>
    </dependency>
    <!-- PlaceholderAPI: só compilação (softdepend), nunca embutido. Só as classes do pacote placeholder o tocam. -->
    <dependency><groupId>me.clip</groupId><artifactId>placeholderapi</artifactId><version>2.11.6</version><scope>provided</scope></dependency>
  </dependencies>

  <build>
    <resources>
      <resource><directory>src/main/resources</directory><filtering>true</filtering>
        <includes><include>plugin.yml</include><include>build.properties</include></includes></resource>
      <resource><directory>src/main/resources</directory><filtering>false</filtering>
        <excludes><exclude>plugin.yml</exclude><exclude>build.properties</exclude></excludes></resource>
    </resources>
  </build>
</project>
